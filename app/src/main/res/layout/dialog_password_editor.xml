<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="标题（如网站 / App 名称）"
            android:textSize="12sp"
            android:textColor="@color/ink_sub" />

        <EditText
            android:id="@+id/dlgPwdTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/ink"
            android:hint="例：12306 / 招商银行"
            android:textColorHint="@color/ink_sub"
            android:singleLine="true"
            android:inputType="text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="账号 / 用户名"
            android:textSize="12sp"
            android:textColor="@color/ink_sub" />

        <EditText
            android:id="@+id/dlgPwdUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/ink"
            android:hint="手机号 / 邮箱 / 昵称"
            android:textColorHint="@color/ink_sub"
            android:singleLine="true"
            android:inputType="text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="密码"
            android:textSize="12sp"
            android:textColor="@color/ink_sub" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/dlgPwdPassword"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="15sp"
                android:textColor="@color/ink"
                android:fontFamily="monospace"
                android:hint="至少 1 个字符"
                android:textColorHint="@color/ink_sub"
                android:singleLine="true"
                android:inputType="textPassword" />

            <Button
                android:id="@+id/dlgPwdTogglePwd"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:text="👁"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="分类"
            android:textSize="12sp"
            android:textColor="@color/ink_sub" />

        <Spinner
            android:id="@+id/dlgPwdCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="备注（找回邮箱 / 安全提示等）"
            android:textSize="12sp"
            android:textColor="@color/ink_sub" />

        <EditText
            android:id="@+id/dlgPwdNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/ink"
            android:hint="可选"
            android:textColorHint="@color/ink_sub"
            android:minLines="2"
            android:maxLines="3"
            android:gravity="top"
            android:inputType="textMultiLine" />
    </LinearLayout>
</ScrollView>
