<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 背景图占满整个 fragment（包含状态栏区域），彻底无缝 -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_anime" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:clipToPadding="false"
        android:paddingTop="22dp"
        android:paddingBottom="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

                <!-- 第一行：象限 ①② -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="4dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/q1_header"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="6dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginEnd="4dp"
                                android:src="@drawable/cat_quad1" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="重要·紧急"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:maxLines="1"
                                android:ellipsize="end" />

                            <Button
                                android:id="@+id/add1"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginStart="4dp"
                                android:padding="0dp"
                                android:text="+"
                                android:textSize="16sp"
                                android:textColor="#FFFFFF" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/zone1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/q1_light"
                            android:minHeight="90dp"
                            android:orientation="vertical"
                            android:padding="4dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="4dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/q2_header"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="6dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginEnd="4dp"
                                android:src="@drawable/cat_quad2" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="重要·不急"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:maxLines="1"
                                android:ellipsize="end" />

                            <Button
                                android:id="@+id/add2"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginStart="4dp"
                                android:padding="0dp"
                                android:text="+"
                                android:textSize="16sp"
                                android:textColor="#FFFFFF" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/zone2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/q2_light"
                            android:minHeight="90dp"
                            android:orientation="vertical"
                            android:padding="4dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 第二行：象限 ③④ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="4dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/q3_header"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="6dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginEnd="4dp"
                                android:src="@drawable/cat_quad3" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="不重要·紧急"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:maxLines="1"
                                android:ellipsize="end" />

                            <Button
                                android:id="@+id/add3"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginStart="4dp"
                                android:padding="0dp"
                                android:text="+"
                                android:textSize="16sp"
                                android:textColor="#FFFFFF" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/zone3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/q3_light"
                            android:minHeight="90dp"
                            android:orientation="vertical"
                            android:padding="4dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="4dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/q4_header"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="6dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginEnd="4dp"
                                android:src="@drawable/cat_quad4" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="不重要·不急"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:maxLines="1"
                                android:ellipsize="end" />

                            <Button
                                android:id="@+id/add4"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginStart="4dp"
                                android:padding="0dp"
                                android:text="+"
                                android:textSize="16sp"
                                android:textColor="#FFFFFF" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/zone4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/q4_light"
                            android:minHeight="90dp"
                            android:orientation="vertical"
                            android:padding="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
</FrameLayout>